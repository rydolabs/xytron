# Verify local, no-network Core restore from an installed xytron CLI.
# This does not claim CEF/WebView2 or backend-runtime download support.
if(NOT DEFINED XYTRON OR NOT DEFINED TEST_ROOT)
  message(FATAL_ERROR "XYTRON and TEST_ROOT required")
endif()
file(REMOVE_RECURSE "${TEST_ROOT}")
file(MAKE_DIRECTORY "${TEST_ROOT}")
execute_process(COMMAND "${XYTRON}" new desktop hello --backend cpp
  WORKING_DIRECTORY "${TEST_ROOT}"
  RESULT_VARIABLE generated OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT generated EQUAL 0)
  message(FATAL_ERROR "Installed xytron new failed: ${out} ${err}")
endif()
function(check expected)
  execute_process(COMMAND "${XYTRON}" ${ARGN}
    WORKING_DIRECTORY "${TEST_ROOT}/hello"
    RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT code EQUAL expected)
    message(FATAL_ERROR "Installed CLI ${ARGN}: expected ${expected}, got ${code}: ${out} ${err}")
  endif()
endfunction()
check(0 restore)
set(lock "${TEST_ROOT}/hello/.xytron/core.lock")
if(NOT EXISTS "${lock}")
  message(FATAL_ERROR "Default restore did not write Core SDK lock")
endif()
file(READ "${lock}" payload)
if(NOT payload MATCHES "^xytron-core-lock-v1")
  message(FATAL_ERROR "Default restore created an invalid lock")
endif()
check(0 restore)
file(READ "${lock}" repeated)
if(NOT repeated STREQUAL payload)
  message(FATAL_ERROR "Idempotent restore changed the lock unexpectedly")
endif()
check(0 doctor)
file(WRITE "${lock}" "tampered-lock\n")
check(1 restore)
file(READ "${lock}" after)
if(NOT after STREQUAL "tampered-lock\n")
  message(FATAL_ERROR "Failed restore overwrote modified lock")
endif()
file(REMOVE "${lock}")
check(0 restore)
check(0 doctor)
message(STATUS "Installed CLI implicit Core restore, lock and doctor PASS")
